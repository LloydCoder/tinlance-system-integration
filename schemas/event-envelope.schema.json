{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinlance.com/schemas/events/cloudevents-v1.json",
  "title": "Tinlance CloudEvents-compatible event envelope",
  "description": "CloudEvents 1.0 JSON event with constrained lowercase extension attributes. Event data is untrusted input and never grants execution authority.",
  "type": "object",
  "required": [
    "specversion", "id", "source", "type", "time", "datacontenttype",
    "tenantid", "executionid", "traceid", "correlationid", "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": { "type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048 },
    "type": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 2048 },
    "tenantid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "organizationid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workspaceid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "actorid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "agentid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "executionid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "traceid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "spanid": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "correlationid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "causationid": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dataclassification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "data": { "type": "object" }
  },
  "additionalProperties": false
}
