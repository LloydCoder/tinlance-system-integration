{
  "schema_version": "1.1.0",
  "format": "cloudevents-1.0-json",
  "schema": "schemas/event-envelope.schema.json",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "tenantid", "executionid", "traceid", "correlationid", "data"],
  "extensions": ["tenantid", "organizationid", "workspaceid", "actorid", "agentid", "executionid", "traceid", "spanid", "correlationid", "causationid", "dataclassification"],
  "rules": {
    "event_identity": "source + id is unique for each distinct event",
    "duplicate_delivery": "consumers deduplicate by source + id",
    "schema_versioned": true,
    "tenant_context_immutable": true,
    "data_is_untrusted": true,
    "event_payload_never_grants_authority": true,
    "transport_delivery": "at-least-once; consumers must be idempotent"
  }
}
