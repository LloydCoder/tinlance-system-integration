{
  "schema_version": "1.1.0",
  "format": "cloudevents-1.0.2-compatible",
  "required": [
    "id",
    "source",
    "specversion",
    "type",
    "time",
    "subject",
    "data",
    "datacontenttype",
    "tenantid",
    "executionid",
    "traceid",
    "correlationid"
  ],
  "extensions": [
    "tenantid",
    "organizationid",
    "workspaceid",
    "actorid",
    "agentid",
    "executionid",
    "traceid",
    "correlationid",
    "causationid",
    "dataschema",
    "dataclassification",
    "idempotencykey"
  ],
  "rules": {
    "event_id_unique_per_source": true,
    "schema_versioned": true,
    "tenant_context_immutable": true,
    "trace_context_preserved": true,
    "delivery_semantics": "at_least_once",
    "unknown_extensions_rejected": true
  }
}
