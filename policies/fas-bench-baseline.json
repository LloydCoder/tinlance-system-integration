{
  "schema_version": "2.0.0",
  "baseline_id": "tsic-05-fas-independent-evaluation-2026-10-09",
  "authority": "tsic",
  "fas": {
    "repository": "LloydCoder/fas",
    "ref": "c3eb2fcaf7e1f02e2ad0dd61ec4c7bee3384e64e"
  },
  "fas_bench": {
    "repository": "LloydCoder/fas-bench",
    "ref": "acf23e4ddb2d435290cf4d7fb09f7ac4b797c5de"
  },
  "artifact_contract": {
    "input": "FAS JSON analysis/report artifact",
    "output": "FAS-Bench submission and evaluation-result artifact",
    "lineage": [
      "fas_analysis_id",
      "fas_report_digest",
      "submission_id",
      "case_id",
      "evaluation_id",
      "evaluator_version",
      "correlation_id"
    ]
  },
  "invariants": [
    "fas_is_production_analysis_authority",
    "fas_bench_is_independent_evaluation_authority",
    "fas_bench_is_not_on_production_execution_path",
    "fas_bench_is_not_imported_by_fas_runtime",
    "analysis_artifact_is_immutable_input_to_adapter",
    "insufficient_evidence_maps_to_unknown_not_clean",
    "evaluation_result_is_reproducible_and_versioned",
    "benchmark_results_do_not_mutate_fas_runtime_state"
  ],
  "execution_gate": {
    "workflow": ".github/workflows/fas-bench-e2e.yml",
    "certifier": "scripts/certify_fas_bench_e2e.py",
    "forensic_audit": "scripts/forensic_audit_phase5.py",
    "requires_live_fas_cli_and_independent_evaluator": true
  }
}
